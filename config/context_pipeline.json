{
  "version": 2,
  "enabled": true,
  "run_online_reasoning": false,
  "online_reasoning_enabled": true,
  "online_reasoning_confidence_threshold": 0.52,
  "online_reasoning_confidence_ceiling_skip": 0.92,
  "online_skip_when_local_confidence_high": true,
  "online_reasoning_contradiction_threshold": 2,
  "online_reasoning_stagnation_threshold": 5,
  "online_reasoning_task_types": [],
  "online_skip_when_memory_pressure": true,
  "maximize_free_tokens": false,
  "online_reasoning_force_when_maximize_free": false,
  "online_skip_when_provider_degraded": true,
  "online_claim_min_confidence": 0.35,
  "online_model": "gpt-4o-mini",
  "online_timeout_sec": 75,
  "local_timeout_sec": 60,
  "local_ollama_model": null,
  "default_task_type": "autonomy_decide_next",
  "memory_recall_limit": 18,
  "include_log_tail": true,
  "log_path": null,
  "chat_export_paths": [],
  "chat_export_max_lines": 120,
  "archive_relevance_threshold": 0.52,
  "archive_decay_enabled": true,
  "archive_decay_stale_weight": 0.018,
  "archive_decay_retrieval_boost": 0.012,
  "archive_decay_reinforce_boost": 0.02,
  "retrieval_top_n": 28,
  "max_total_retrieved_items": 36,
  "source_retrieval_caps": {
    "user_input": 5,
    "memory": 6,
    "chat_history": 3,
    "log": 3,
    "browser_finding": 3,
    "planner_snapshot": 4,
    "task_snapshot": 4,
    "monitor_snapshot": 2,
    "unknown": 2
  },
  "contradiction_surface_confidence": 0.55,
  "max_facts": 10,
  "max_constraints": 8,
  "max_risks": 6,
  "max_unknowns": 6,
  "max_evidence": 14,
  "recency_half_life_hours": 48,
  "semantic_backend": "tfidf",
  "embedding_model": "nomic-embed-text",
  "embedding_provider": "ollama",
  "embedding_cache_enabled": true,
  "embedding_batch_size": 8,
  "embedding_http_timeout_sec": 30,
  "embedding_cache_max_entries": 4096,
  "embedding_similarity_threshold": 0.0,
  "legacy_planner_injection": true,
  "legacy_injection_max_chars": 900,
  "source_priority_weights": {
    "user_input": 0.98,
    "memory": 0.82,
    "chat_history": 0.72,
    "log": 0.58,
    "browser_finding": 0.7,
    "task_snapshot": 0.8,
    "monitor_snapshot": 0.76,
    "planner_snapshot": 0.78,
    "unknown": 0.55
  },
  "keyword_rules": [
    {
      "keywords": ["error", "exception", "timeout", "fail"],
      "weight": 0.12
    },
    {
      "keywords": ["goal", "objective", "milestone", "deadline"],
      "weight": 0.1
    },
    {
      "phrases": ["must not", "do not", "never deploy"],
      "weight": 0.14
    }
  ]
}
