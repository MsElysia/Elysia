{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Elysia Autopilot Task Packet",
  "type": "object",
  "required": ["task_id", "title", "objective", "status", "risk_class", "acceptance_criteria"],
  "properties": {
    "task_id": {"type": "string", "pattern": "^ELY-TASK-[0-9]{6,}$"},
    "title": {"type": "string", "minLength": 1},
    "objective": {"type": "string", "minLength": 1},
    "status": {"enum": ["queued", "claimed", "running", "review", "blocked", "completed", "rejected", "archived"]},
    "task_class": {"enum": ["research", "archaeology", "analysis", "design", "implementation", "test", "review", "documentation", "integration", "migration", "security", "governance", "other"]},
    "risk_class": {"enum": ["read_only", "sandbox_write", "repo_write", "external_write", "deployment", "sensitive_data", "privileged"]},
    "required_capabilities": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true, "default": []},
    "preferred_worker": {"type": ["string", "null"]},
    "allowed_workers": {"type": "array", "items": {"type": "string"}, "default": []},
    "dependencies": {"type": "array", "items": {"type": "string"}, "default": []},
    "source_refs": {"type": "array", "items": {"type": "string"}, "default": []},
    "files_in_scope": {"type": "array", "items": {"type": "string"}, "default": []},
    "files_out_of_scope": {"type": "array", "items": {"type": "string"}, "default": []},
    "acceptance_criteria": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "required_checks": {"type": "array", "items": {"type": "string"}, "default": []},
    "required_review_roles": {"type": "array", "items": {"type": "string"}, "default": []},
    "human_approval_required": {"type": "boolean", "default": false},
    "max_attempts": {"type": "integer", "minimum": 1, "default": 3},
    "attempt": {"type": "integer", "minimum": 0, "default": 0},
    "branch_hint": {"type": ["string", "null"]},
    "parent_task": {"type": ["string", "null"]},
    "created_by": {"type": ["string", "null"]},
    "created_at": {"type": ["string", "null"], "format": "date-time"},
    "notes": {"type": "array", "items": {"type": "string"}, "default": []}
  },
  "additionalProperties": false
}
