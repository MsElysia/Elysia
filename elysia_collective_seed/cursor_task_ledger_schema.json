{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Elysia Cursor Consolidation Task Ledger",
  "type": "object",
  "required": ["goal_id", "goal", "status", "tasks"],
  "properties": {
    "goal_id": {"type": "string", "minLength": 1},
    "goal": {"type": "string", "minLength": 1},
    "status": {"enum": ["planned", "active", "blocked", "complete", "paused"]},
    "created_at": {"type": ["string", "null"], "format": "date-time"},
    "updated_at": {"type": ["string", "null"], "format": "date-time"},
    "canonical_root": {"type": ["string", "null"]},
    "legacy_roots": {"type": "array", "items": {"type": "string"}, "default": []},
    "tasks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["task_id", "objective", "role", "status", "acceptance_criteria"],
        "properties": {
          "task_id": {"type": "string", "minLength": 1},
          "parent_task_id": {"type": ["string", "null"]},
          "objective": {"type": "string", "minLength": 1},
          "role": {
            "enum": [
              "guardian-archaeologist",
              "guardian-correspondence-analyst",
              "guardian-consolidator",
              "guardian-verifier",
              "guardian-archivist",
              "guardian-relay",
              "human-review"
            ]
          },
          "status": {"enum": ["queued", "active", "blocked", "complete", "failed", "human_review"]},
          "inputs": {"type": "array", "items": {"type": "string"}, "default": []},
          "acceptance_criteria": {"type": "array", "items": {"type": "string"}, "minItems": 1},
          "depends_on": {"type": "array", "items": {"type": "string"}, "default": []},
          "handoff_artifact": {"type": ["string", "null"]},
          "branch_or_worktree": {"type": ["string", "null"]},
          "human_approval_required": {"type": "boolean", "default": false},
          "notes": {"type": "array", "items": {"type": "string"}, "default": []}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
